# Nusxa olib .env.public nomi bilan saqlang. Bu faylda maxfiy qiymat bo'lmasin.
TIBEX_ENV=production
TIBEX_ALLOWED_ORIGINS=["https://tibex.uz","https://www.tibex.uz"]
TIBEX_COOKIE_SECURE=true
TIBEX_COOKIE_SAMESITE=lax
TIBEX_SERVE_FRONTEND=false
TIBEX_DEBUG_AUTH_LOGGING=false
TIBEX_SESSION_TTL_MINUTES=480
TIBEX_INACTIVITY_MINUTES=30
TIBEX_LOGIN_LOCKOUT_MINUTES=15
TIBEX_MAX_LOGIN_ATTEMPTS=5
TIBEX_CLINIC_TIMEZONE=Asia/Tashkent
TIBEX_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
TIBEX_MASTER_ACTIVE_KEY_ID=1

# Maxfiy qiymatlar docker-compose.yml orqali /run/secrets ichidan o'qiladi.
# TIBEX_DATABASE_URL_FILE, TIBEX_REDIS_URL_FILE, TIBEX_SECRET_KEY_FILE,
# TIBEX_MASTER_KEY_B64_FILE, TIBEX_MASTER_KEYS_FILE,
# TIBEX_BLIND_INDEX_KEY_B64_FILE,
# TIBEX_PASSWORD_PEPPER_FILE, TIBEX_TELEGRAM_BOT_TOKEN_FILE va
# TIBEX_TELEGRAM_WEBHOOK_SECRET_FILE ni compose fayli belgilaydi.

# 29-band: kuzatuv
TIBEX_LOG_JSON=true
# TIBEX_SENTRY_DSN=
# TIBEX_METRICS_TOKEN=CHANGE_ME

# Klinika NAT/ofis IP'lari (vergul bilan); avto-blokdan istisno.
TIBEX_THREAT_WHITELIST=127.0.0.1,::1,localhost
TIBEX_BOOTSTRAP_PATIENT_DAYS=30
TIBEX_BOOTSTRAP_APPOINTMENT_DAYS=7
# TIBEX_TELEGRAM_BOT_USERNAME=CHANGE_ME
# Sir bo'lgani uchun ESKIZ tokeni faqat *_FILE orqali beriladi (TIBEX_ESKIZ_TOKEN_FILE).
